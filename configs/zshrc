# ~/.zshrc - developer setup for Arch Linux ARM (Swipterm/iPhone)

# ---- Basics ----
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EDITOR="${EDITOR:-nvim}"
export VISUAL="$EDITOR"
export PAGER="${PAGER:-less}"
export LESS="-RFX"

# PATH
export PATH="$HOME/.local/bin:$HOME/bin:/opt/code-server/bin:$HOME/.opencode/bin:$PATH"
# GitHub token (stored in ~/.config/github/token)
export GITHUB_TOKEN="$(cat "$HOME/.config/github/token" 2>/dev/null)"
# Go/Rust if installed
[ -d /usr/local/go/bin ] && export PATH="/usr/local/go/bin:$PATH"
[ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH"
[ -d "$HOME/go/bin" ] && export PATH="$HOME/go/bin:$PATH"

# ---- History ----
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY

# ---- Completion ----
fpath=(/usr/share/zsh/site-functions $fpath)
autoload -Uz compinit && compinit -C
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' group-name ''

# ---- Plugins ----
[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# ---- fzf ----
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh
export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border --info=inline'

# ---- zoxide ----
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# ---- starship prompt ----
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# ---- Aliases: shortcuts ----
alias c='clear'
alias e='exit'
alias q='exit'
alias r='source ~/.zshrc'
alias h='history'
alias j='jobs -l'
alias path='echo $PATH | tr ":" "\\n"'
alias now='date +"%Y-%m-%d %H:%M:%S"'
alias ports='ss -tulpn'
alias myip='curl -s https://ifconfig.me; echo'
alias please='sudo'
alias x='exit'
alias help='tips'
# updates
alias updates='checkupdates 2>/dev/null || pacman -Qu'
alias upgrade='sys-update'
alias cleanup='sys-cleanup'
alias code-update='code-server-update'
alias fullupgrade='sys-update && code-server-update && sys-cleanup'

# ---- Aliases: navigation ----
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias -- -='cd -'

# ---- Aliases: listing ----
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -la --group-directories-first --git'
  alias la='eza -a --group-directories-first'
  alias lt='eza --tree --level=2 --group-directories-first'
  alias l='eza -l --group-directories-first'
else
  alias ls='ls --color=auto'
  alias ll='ls -lah'
  alias la='ls -A'
fi
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
command -v fd >/dev/null 2>&1 && alias find='fd'
command -v tree >/dev/null 2>&1 && alias tree='tree -C'
alias du='duf'
alias duh='dust'
alias top='btop'
alias sys='procs'
alias bench='hyperfine'
alias loc='tokei'
alias http='xh'

# ---- Aliases: git ----
alias g='git'
alias gs='git status -sb'
alias ga='git add'
alias gaa='git add -A'
alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit --amend'
alias gp='git push'
alias gpl='git pull'
alias gl='git log --oneline --graph --decorate -20'
alias gd='git diff'
alias gds='git diff --staged'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gb='git branch'
alias gba='git branch -a'
alias gst='git stash'
alias gsp='git stash pop'

# ---- Aliases: dev ----
alias v='nvim'
alias vi='vim'
alias code='code-server'
alias cs='code-server'
alias py='python3'
alias pip='python3 -m pip'
alias nodev='node --version && npm --version'
alias serve='python3 -m http.server 8000'
alias json='jq .'

# ---- Aliases: system ----
alias update='sudo pacman -Syu'
alias install='sudo pacman -S'
alias search='pacman -Ss'
alias ff='fastfetch'
alias reload='source ~/.zshrc'
alias cls='clear'

# ---- Aliases: containers ----
alias d='docker'
alias dc='docker compose'
alias p='podman'

# ---- Aliases: tmux ----
alias t='tmux'
alias ta='tmux attach -t'
alias tl='tmux ls'
alias tn='tmux new -s'

# ---- Helper functions ----
mkcd() { mkdir -p "$1" && cd "$1"; }
extract() {
  case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz)  tar xzf "$1" ;;
    *.tar.xz)  tar xJf "$1" ;;
    *.bz2)     bunzip2 "$1" ;;
    *.gz)      gunzip "$1" ;;
    *.tar)     tar xf "$1" ;;
    *.zip)     unzip "$1" ;;
    *.7z)      7z x "$1" ;;
    *) echo "Unknown archive format: $1" ;;
  esac
}
gclone() { git clone "$1" && cd "$(basename "$1" .git)"; }

# ---- Quick tips ----
tips() {
  print -P "%F{green}devbox shortcuts%f"
  print -P "%F{yellow}Shell%f"
  print -P "  %F{white}c%f clear  %F{white}e/q/x%f exit  %F{white}r%f reload  %F{white}h%f history"
  print -P "  %F{white}j%f jobs  %F{white}path%f  %F{white}now%f  %F{white}ports%f  %F{white}myip%f"
  print -P "%F{yellow}Files & Git%f"
  print -P "  %F{white}ll%f listing  %F{white}tree%f view  %F{white}gs%f status  %F{white}gd%f diff"
  print -P "  %F{white}gl%f log  %F{white}gco%f checkout  %F{white}mkcd%f  %F{white}extract%f"
  print -P "%F{yellow}Dev & System%f"
  print -P "  %F{white}v%f nvim  %F{white}code/cs%f code-server  %F{white}t%f tmux"
  print -P "  %F{white}oc%f opencode  %F{white}ocs%f serve  %F{white}ocp%f pair remote"
  print -P "  %F{white}ff%f fastfetch  %F{white}top%f btop  %F{white}sys%f procs"
  print -P "  %F{white}update/upgrade%f  %F{white}updates%f  %F{white}cleanup%f"
  print -P "  %F{white}code-update%f  %F{white}fullupgrade%f  %F{white}tips%f  %F{white}help%f"
  print -P "%F{yellow}Disk / Perf%f"
  print -P "  %F{white}ncdu%f  %F{white}duf%f  %F{white}dust%f  %F{white}bench%f  %F{white}loc%f"
}

# ---- OpenCode auto-start (background, silent) ----
__opencode_autostart() {
  (
    command -v opencode >/dev/null 2>&1 || exit 0
    opencode service status >/dev/null 2>&1 && exit 0
    opencode service start >/dev/null 2>&1
  ) >/dev/null 2>&1 &
}
__opencode_autostart
alias oc='opencode'
alias ocs='opencode service start'
alias ocp='opencode pair --remote --yes'

# ---- Custom greeting (compact, phone-friendly) ----
__dev_greet() {
  local branch=""
  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    branch="  %F{magenta}($(git symbolic-ref --short HEAD 2>/dev/null))%f"
  fi
  print -P "%F{green}devbox%f %F{blue}Arch ARM%f | %F{yellow}$(date +'%a %d %b %H:%M')%f${branch}"
  print -P "%F{8}type 'ff' for system info, 'tips' for shortcuts%f"
}
if [[ -o interactive ]] && [[ -t 1 ]]; then
  __dev_greet
fi