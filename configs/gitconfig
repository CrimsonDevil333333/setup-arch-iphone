[user]
	name = Developer
	email = dev@arch.local
[init]
	defaultBranch = main
[pull]
	rebase = true
[core]
	editor = nvim
	autocrlf = input
	pager = delta
[color]
	ui = auto
[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate -20
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
