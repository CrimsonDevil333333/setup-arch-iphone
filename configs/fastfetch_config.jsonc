{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "position": "top",
    "padding": {
      "top": 0,
      "right": 0,
      "bottom": 1
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    },
    "size": {
      "binaryPrefix": "si"
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "□"
      },
      "width": 10
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    "break",
    "colors"
  ]
}